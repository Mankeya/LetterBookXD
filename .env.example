# ============================================
# LetterBookXD - Environment Variables
# ============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ============================================
# APPLICATION
# ============================================
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:8080
VITE_API_URL=http://localhost:8080
VITE_APP_URL=http://localhost:3000

# ============================================
# DATABASE (MySQL 8.0+)
# ============================================
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_USER=letterbookxd
MYSQL_PASSWORD=password
MYSQL_DATABASE=letterbookxd
DATABASE_URL=mysql://letterbookxd:password@localhost:3306/letterbookxd

# For production with SSL:
# DATABASE_URL=mysql://user:pass@host:3306/db?tls=verify-full&sslcert=/certs/client-cert.pem&sslkey=/certs/client-key.pem&sslca=/certs/ca.pem

# ============================================
# REDIS (Cache + Sessions + Rate Limit)
# ============================================
REDIS_URL=redis://localhost:6379
# For production with TLS:
# REDIS_URL=rediss://user:pass@host:6379?tls=true

# ============================================
# JWT (HS256 - 256-bit key)
# Generate with: openssl rand -base64 32
# ============================================
JWT_SECRET=your-256-bit-base64-encoded-secret-key-here-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ============================================
# BCRYPT
# ============================================
BCRYPT_COST=12

# ============================================
# CORS
# ============================================
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=info
LOKI_URL=http://localhost:3100

# ============================================
# LGPD COMPLIANCE
# ============================================
DPO_EMAIL=dpo@letterbookxd.com
DATA_RETENTION_DAYS=365

# ============================================
# GRAFANA
# ============================================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ============================================
# EXTERNAL APIs (Optional - for higher rate limits)
# ============================================
# MANGADEX_API_TOKEN=your-mangadex-token
# GOOGLE_BOOKS_API_KEY=your-google-books-key
